@model IEnumerable<Rsvp>
@{
    ViewData["Title"] = "Registrations";
    var counter = 1;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">All Registrations <span class="badge bg-primary fs-6 align-middle">@Model.Count()</span></h1>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-controller="Workshops" asp-action="RsvpForm">New RSVP</a>
        <a class="btn btn-outline-secondary" asp-controller="Workshops" asp-action="Index">Back to Workshops</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No one has registered yet. Be the first!</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle border">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>@Html.DisplayNameFor(m => m.FullName)</th>
                    <th>@Html.DisplayNameFor(m => m.Email)</th>
                    <th>@Html.DisplayNameFor(m => m.WorkshopTitle)</th>
                    <th>Accommodation</th>
                    <th>@Html.DisplayNameFor(m => m.RegisteredOn)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@(counter++)</td>
                        <td>@r.FullName</td>
                        <td>@r.Email</td>
                        <td>@r.WorkshopTitle</td>
                        <td>
                            @if (r.NeedsAccommodation)
                            {
                                <span class="badge bg-warning text-dark">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </td>
                        <td>@r.RegisteredOn.ToString("MMM d, yyyy h:mm tt")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
